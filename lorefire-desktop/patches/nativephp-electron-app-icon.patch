+        // Always republish public/ icons. electron-vite ?asset can keep a stale
+        // default cog in resources/ or out/ from an earlier serve.
+        $js = __DIR__.'/../../resources/js';
+        $pairs = [
+            ['icon.png', $js.'/build/icon.png'],
+            ['icon.png', $js.'/resources/icon.png'],
+            ['icon.ico', $js.'/build/icon.ico'],
+            ['icon.ico', $js.'/resources/icon.ico'],
+            ['icon.icns', $js.'/build/icon.icns'],
+            ['icon.icns', $js.'/resources/icon.icns'],
+            ['IconTemplate.png', $js.'/resources/IconTemplate.png'],
+            ['IconTemplate@2x.png', $js.'/resources/IconTemplate@2x.png'],
+        ];
+
+        foreach ($pairs as [$name, $dest]) {
+            $src = public_path($name);
+            if (! is_file($src)) {
+                continue;
+            }
+            $dir = dirname($dest);
+            if (! is_dir($dir)) {
+                @mkdir($dir, 0777, true);
+            }
+            @copy($src, $dest);
+        }
+
+        $master = public_path('icon.png');
+        $out = $js.'/out';
+        if (is_file($master) && is_dir($out)) {
+            $iterator = new \RecursiveIteratorIterator(
+                new \RecursiveDirectoryIterator($out, \FilesystemIterator::SKIP_DOTS)
+            );
+            foreach ($iterator as $file) {
+                if ($file->isFile() && strcasecmp($file->getFilename(), 'icon.png') === 0) {
+                    @copy($master, $file->getPathname());
+                }
+            }
+        }
     }
