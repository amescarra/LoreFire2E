+    /**
+     * Real NativePHP zip-version knob (env NATIVEPHP_PHP_BINARY_VERSION).
+     * There is no Laravel config key. Stock electron hardcodes the host PHP
+     * minor. On Linux x64, if php-{host}.zip is missing, request 8.4 then 8.3.
+     * Unchanged on Windows (including ARM).
+     */
+    protected function nativephpPhpBinaryVersion(): string
+    {
+        $running = PHP_MAJOR_VERSION.'.'.PHP_MINOR_VERSION;
+        if (PHP_OS_FAMILY !== 'Linux') {
+            return $running;
+        }
+
+        $machine = strtolower(php_uname('m'));
+        if (! in_array($machine, ['x86_64', 'amd64'], true)) {
+            return $running;
+        }
+
+        $dir = rtrim(base_path($this->phpBinaryPath()), '/').'/linux/x64';
+        $configured = getenv('NATIVEPHP_PHP_BINARY_VERSION') ?: '';
+        if (is_string($configured) && $configured !== '' && is_file($dir.'/php-'.$configured.'.zip')) {
+            return $configured;
+        }
+        if (is_file($dir.'/php-'.$running.'.zip')) {
+            return $running;
+        }
+        foreach (['8.4', '8.3'] as $fallback) {
+            if (is_file($dir.'/php-'.$fallback.'.zip')) {
+                return $fallback;
+            }
+        }
+
+        return $running;
+    }
+
+    /**
+     * Absolute path to an ARM64 php.exe for native:serve on Windows ARM.
+     * Empty on every other platform so Electron keeps using php-bin.
+     */
+    protected function windowsArm64SystemPhp(): string
+    {
+        $configured = getenv('NATIVEPHP_PHP_EXECUTABLE') ?: '';
+        if (is_string($configured) && $configured !== '' && is_file($configured)) {
+            return $configured;
+        }
+
+        if (PHP_OS_FAMILY !== 'Windows') {
+            return '';
+        }
+
+        $machine = strtolower(php_uname('m'));
+        $isArmPhp = str_contains($machine, 'arm') || str_contains($machine, 'aarch');
+        if (! $isArmPhp) {
+            return '';
+        }
+
+        return PHP_BINARY;
+    }
+
+    /**
+     * System PHP for Linux x64 native:serve only when no php-bin zip can be
+     * selected (after 8.4/8.3 fallback). Empty when a zip exists.
+     */
+    protected function linuxX64SystemPhpWhenBinMissing(): string
+    {
+        if (PHP_OS_FAMILY !== 'Linux') {
+            return '';
+        }
+
+        $machine = strtolower(php_uname('m'));
+        if (! in_array($machine, ['x86_64', 'amd64'], true)) {
+            return '';
+        }
+
+        $version = $this->nativephpPhpBinaryVersion();
+        $zip = rtrim(base_path($this->phpBinaryPath()), '/').'/linux/x64/php-'.$version.'.zip';
+        if (is_file($zip)) {
+            return '';
+        }
+
+        return is_file(PHP_BINARY) ? PHP_BINARY : '';
+    }
